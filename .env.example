# NeuroAgent Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it's in .gitignore

# ── LLM ───────────────────────────────────────────────────────────────────────
# HuggingFace token (for downloading gated models like Llama)
HUGGINGFACE_TOKEN=your_hf_token_here

# ── PubMed / NCBI ─────────────────────────────────────────────────────────────
# Get your free API key at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=your_ncbi_key_here

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Vector Store ──────────────────────────────────────────────────────────────
VECTOR_STORE_PATH=data/vector_store
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# ── Vision Model ──────────────────────────────────────────────────────────────
VISION_MODEL_PATH=models/vision/weights/best_model.pth
CONFIDENCE_THRESHOLD=0.75  # Cases below this are flagged for human review

# ── LLM Model ─────────────────────────────────────────────────────────────────
LLM_MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
# Or use: microsoft/Phi-3-mini-4k-instruct
LLM_USE_4BIT=true
LORA_ADAPTER_PATH=models/llm/weights/lora_adapter
